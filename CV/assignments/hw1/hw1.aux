\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Projection results for $f = 10, 50, 100$. Notice how larger $f$ magnifies the projection. At $f=10$, points are clustered near the center. At $f=100$, the same points spread across a much larger area.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:focal}{{1}{6}{Projection results for $f = 10, 50, 100$. Notice how larger $f$ magnifies the projection. At $f=10$, points are clustered near the center. At $f=100$, the same points spread across a much larger area}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Projection onto tilted plane $0.1x + 1z - 50 = 0$. The keystoning effect is visible---the left side is compressed while the right side is expanded.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:tilted}{{2}{7}{Projection onto tilted plane $0.1x + 1z - 50 = 0$. The keystoning effect is visible---the left side is compressed while the right side is expanded}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Six canonical views of the 3D point cloud. Each view shows the scene from a different camera position: Front, Back, Left, Right, Top, and Bottom. Notice how the same 3D scene appears completely different depending on the viewing angle.}}{13}{figure.3}\protected@file@percent }
\newlabel{fig:sixviews}{{3}{13}{Six canonical views of the 3D point cloud. Each view shows the scene from a different camera position: Front, Back, Left, Right, Top, and Bottom. Notice how the same 3D scene appears completely different depending on the viewing angle}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Six views of the custom captured scene using the ReVo 3D camera. The same rendering pipeline was applied to demonstrate generalization to different point clouds.}}{14}{figure.4}\protected@file@percent }
\newlabel{fig:custom}{{4}{14}{Six views of the custom captured scene using the ReVo 3D camera. The same rendering pipeline was applied to demonstrate generalization to different point clouds}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Demosaiced RGB image from raw Bayer data using bilinear interpolation. The algorithm successfully reconstructs a full-color image from the single-channel Bayer pattern.}}{18}{figure.5}\protected@file@percent }
\newlabel{fig:demosaic}{{5}{18}{Demosaiced RGB image from raw Bayer data using bilinear interpolation. The algorithm successfully reconstructs a full-color image from the single-channel Bayer pattern}{figure.5}{}}
